{
  "name": "agent-lee",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @agentlee/server dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "start": "pnpm --filter @agentlee/server start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "db:migrate": "pnpm --filter @agentlee/server db:migrate",
    "keygen": "pnpm --filter @agentlee/server keygen",
    "restore": "pnpm --filter @agentlee/server restore",
    "injection-eval": "pnpm --filter @agentlee/server injection-eval",
    "skills:install": "pnpm --filter @agentlee/server skills install",
    "skills:status": "pnpm --filter @agentlee/server skills status",
    "python:install": "pnpm --filter @agentlee/server skills python-install",
    "python:setup-check": "pnpm --filter @agentlee/server skills python-setup-check",
    "python:check": "pnpm --filter @agentlee/server skills python-check",
    "sse-probe": "tsx scripts/sse-probe.ts",
    "uptime": "tsx scripts/uptime.ts",
    "launchd": "bash scripts/install-launchd.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@types/node": "22.20.5",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "@swc/helpers": "0.5.23",
      "tslib": "2.8.1",
      "wasm-feature-detect": "1.9.0"
    },
    "ignoredOptionalDependencies": [
      "@napi-rs/canvas"
    ]
  }
}
