{
  "name": "@agentlee/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --exclude \"../web/**\" --conditions=development --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development src/cli/migrate.ts",
    "keygen": "tsx --conditions=development src/cli/keygen.ts"
  },
  "dependencies": {
    "@agentlee/shared": "workspace:*",
    "@fastify/middie": "9.3.6",
    "@fastify/static": "10.1.10",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "vite": "8.3.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11"
  }
}
