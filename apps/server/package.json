{
  "name": "@agentlee/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --exclude \"../web/**\" --conditions=development --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development src/cli/migrate.ts",
    "keygen": "tsx --conditions=development src/cli/keygen.ts",
    "restore": "tsx --conditions=development src/cli/restore.ts",
    "injection-eval": "tsx --conditions=development src/cli/injection-eval.ts",
    "skills": "tsx --conditions=development src/cli/skills.ts"
  },
  "dependencies": {
    "@agentlee/mcp-tools": "workspace:*",
    "@agentlee/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@expo-google-fonts/gothic-a1": "0.4.1",
    "@fastify/middie": "9.3.6",
    "@fastify/static": "10.1.10",
    "@node-rs/argon2": "2.2.2",
    "@openai/codex": "0.165.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "better-sqlite3": "13.0.3",
    "docx": "9.15.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "jose": "6.2.16",
    "jszip": "3.10.2",
    "pdfkit": "0.20.2",
    "pptxgenjs": "4.0.1",
    "saxes": "5.0.1",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "vite": "8.3.6",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "pdfjs-dist": "6.4.299"
  }
}
