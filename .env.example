# Agent Lee server settings (copy to .env). Secrets never go in this file.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# development | production | test
NODE_ENV=development
# Credential-encryption master key (created by `pnpm keygen`, mode 600). Must be outside DATA_DIR.
# MASTER_KEY_PATH=~/.agentlee/master.key
# Daily backups (docs/ops.md §21). Default: <home>/agentlee-backups. Absolute path, outside DATA_DIR and the
# repository, never in the master key's folder.
# BACKUP_DIR=/Users/<you>/agentlee-backups
# Enables /api/diag/stream for SSE measurement (docs/ops.md §8). Leave off in normal operation.
# DIAG_STREAM=1
# Temporary access-code page (/gate) until Cloudflare Access is set up (docs/ops.md §7). Put the code only in .env.
# TEMP_GATE_CODE=
# Public hostname behind Cloudflare Tunnel (requests with this Host must carry a valid Access JWT).
# PUBLIC_HOST=chat.2prostream.com
# Cloudflare Access (docs/ops.md §7): team domain and application AUD tag. Set both, only in .env.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=
# Context builder (docs/ops.md §27): summarise a long conversation at this share of the model's context window
# (0.3–0.95, default 0.7), keeping the last N messages as they are (2–50, default 6).
# CONTEXT_SUMMARY_RATIO=0.7
# CONTEXT_RECENT_MESSAGES=6
# Scripted fake runtime for local development only (never with real family data): /tool <s>, /long <n>, /error, /limit.
# FAKE_RUNTIME=1
# File text extraction (#48, docs/ops.md §26): OCR of pictures and scanned PDFs uses the bundled tesseract.js and
# language packages (nothing to install). Set to "off" to skip OCR (pictures then report ocr_unavailable).
# EXTRACT_OCR=off
